# NoorAI Tracks on the school server. Copy this file to deploy/.env and fill in the values.
# deploy/.env holds secrets: it is never committed and never goes into the Docker image.

# Database password: letters and digits only (it is used inside a connection address).
# Make one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Sign-in secret. Make one with:  openssl rand -base64 33
AUTH_SECRET=

# The address people type inside the school (used in invite, reset and certificate links).
# Examples: http://192.168.1.50:3100   or   http://tracks.school.lan
APP_URL=

# The port on the server (change only if 3100 is taken).
TRACKS_PORT=3100

# First platform admin and school: used only on a brand-new, empty database.
# After moving the data from Neon they already exist and these are ignored (keep the same email).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ORG_NAME=

# Backups (story 5): where nightly backups go, and an off-server folder for the weekly copy
# (a mounted USB disk or network share). Leave OFFSITE_DIR empty until one is mounted.
BACKUP_DIR=/srv/noorai-tracks/backups
OFFSITE_DIR=

# Google sign-in stays off inside the school (it needs an internet address). Phase 2.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
