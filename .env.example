# Copy this file to .env for local work. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit the real .env.

# Database (Neon). DATABASE_URL = the POOLED string (host has "-pooler"),
# DIRECT_URL = the direct string (no "-pooler"), used only for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate a secret with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST=true

# Google sign-in (optional — the Google button only appears when both are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# First platform admin and first school — created on the first build only.
# The password is used only when the account is first created; you can delete
# SEED_ADMIN_PASSWORD from Vercel after your first successful sign-in.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
SEED_ADMIN_NAME="Your Name"
SEED_ORG_NAME="Special Technician"

# Optional: the public address used in invite links (e.g. https://tracks.noorai.pk).
# If empty, the app uses the address the request came in on.
APP_URL=""
